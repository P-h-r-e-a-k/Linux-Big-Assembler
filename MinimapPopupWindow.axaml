<Window x:Class="LBAAssembler.MinimapPopupWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minimap" Height="520" Width="520" MinHeight="240" MinWidth="240"
        Background="#E8F0FA" Foreground="#10243E" FontFamily="{StaticResource EditorFont}"
        WindowStartupLocation="CenterOwner">
    <Border Margin="12" Background="Black" BorderBrush="#A9C3E0" BorderThickness="1">
        <Grid x:Name="PopupContent" Cursor="Hand" PointerPressed="PopupContent_MouseLeftButtonDown">
            <Image x:Name="PopupImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/>
        </Grid>
    </Border>
</Window>
