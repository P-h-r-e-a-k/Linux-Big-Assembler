<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loads the app's XAML (styles, templates, bindings) on Avalonia's headless platform so a bad property name shows up here
       instead of when a window is first opened. The compiled XAML already checks most of that at build time (the Avalonia XAML
       compiler fails the build on an unknown property or handler); this also lays every window out and can render it to a PNG. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <ProjectReference Include="..\..\LBAAssembler.csproj" />
  </ItemGroup>

</Project>
