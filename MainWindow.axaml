<Window x:Class="LBAAssembler.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LBAAssembler"
        Title="LBA Assembler" Height="760" Width="1280" MinHeight="620" MinWidth="980"
        Background="{DynamicResource ThemeFieldBrush}" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="{StaticResource EditorFont}" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel"><Setter Property="Margin" Value="0,0,0,6"/></Style>
    </Window.Styles>
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" Background="{DynamicResource ThemeRaisedBrush}" Foreground="{DynamicResource ThemeTextBrush}" Padding="6,2" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File" Foreground="{DynamicResource ThemeTextBrush}">
                <MenuItem Header="_Open…" InputGesture="Ctrl+O" Click="Open_Click"/>
                <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="Save_Click"/>
                <Separator/>
                <MenuItem Header="Se_ttings…" Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" Foreground="{DynamicResource ThemeTextBrush}" SubmenuOpened="EditMenu_SubmenuOpened">
                <MenuItem x:Name="UndoMenuItem" Header="_Undo" InputGesture="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem x:Name="RedoMenuItem" Header="_Redo" InputGesture="Ctrl+Y" Click="Redo_Click"/>
            </MenuItem>
            <MenuItem Header="_View" Foreground="{DynamicResource ThemeTextBrush}">
                <MenuItem Header="Zoom _In" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom _Out" Click="ZoomOut_Click"/>
                <MenuItem Header="Zoom to _Fit / Reset View" Click="ViewFit_Click"/>
                <Separator/>
                <MenuItem Header="_Explore mode" InputGesture="Ctrl+1" Click="ModeMenu_Click" Tag="0"/>
                <MenuItem Header="_Build mode" InputGesture="Ctrl+2" Click="ModeMenu_Click" Tag="1"/>
                <MenuItem Header="_Script mode" InputGesture="Ctrl+3" Click="ModeMenu_Click" Tag="2"/>
                <Separator/>
                <MenuItem Header="_Panels" ToolTip.Tip="Bring back a panel you closed or floated out of reach">
                    <MenuItem Header="Location" Click="ShowPanel_Click" Tag="Location"/>
                    <MenuItem Header="Mode" Click="ShowPanel_Click" Tag="Mode"/>
                    <MenuItem Header="Zones" Click="ShowPanel_Click" Tag="Zones"/>
                    <MenuItem Header="Zone details" Click="ShowPanel_Click" Tag="Details"/>
                    <MenuItem Header="Build" Click="ShowPanel_Click" Tag="Build"/>
                    <MenuItem Header="Play" Click="ShowPanel_Click" Tag="Play"/>
                    <MenuItem Header="Script" Click="ShowPanel_Click" Tag="Script"/>
                    <MenuItem Header="Minimap" Click="ShowPanel_Click" Tag="Minimap"/>
                    <Separator/>
                    <MenuItem Header="Reset panel layout" Click="ResetPanelLayout_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Scenes" Foreground="{DynamicResource ThemeTextBrush}">
                <MenuItem x:Name="Lba1Menu" Header="LBA_1" SubmenuOpened="GameMenu_SubmenuOpened"><MenuItem Header="…"/></MenuItem>
                <MenuItem x:Name="Lba2Menu" Header="LBA_2" SubmenuOpened="GameMenu_SubmenuOpened"><MenuItem Header="…"/></MenuItem>
            </MenuItem>
            <MenuItem Header="_Tools" Foreground="{DynamicResource ThemeTextBrush}" SubmenuOpened="ToolsMenu_SubmenuOpened">
                <MenuItem Header="_Editors" ToolTip.Tip="Also reachable from the Build tab's Editors panel, and (Body Studio) from Objects and bodies">
                    <MenuItem Header="_Body Studio…" Click="BodyStudio_Click"/>
                    <MenuItem Header="_Animation Studio…" Click="AnimationStudio_Click"/>
                    <MenuItem x:Name="ObjectBrowserMenuItem" Header="LBA1 / LBA2: _objects and bodies…" Click="ObjectBrowser_Click"/>
                    <MenuItem x:Name="AssetEditorMenuItem" Header="LBA1 / LBA2: br_icks and sprites…" Click="AssetEditor_Click"/>
                    <MenuItem x:Name="GridEditorMenuItem" Header="LBA1 / LBA2: interior _grid editor…" Click="GridEditor_Click"/>
                    <MenuItem x:Name="ExportMenuItem" Header="LBA1 / LBA2: e_xport 3D models…" Click="Export3D_Click" ToolTip.Tip="Islands (with their objects and the Desert island race track), buildings, interiors, every actor and body, furniture and items, as glTF, OBJ, PLY or STL"/>
                    <Separator/>
                    <MenuItem x:Name="Lba1EditorMenuItem" Header="LBA1: scene _editor…" Click="Lba1Editor_Click"/>
                    <MenuItem x:Name="Lba2EditorMenuItem" Header="LBA2: scene e_ditor…" Click="Lba2Editor_Click"/>
                    <MenuItem x:Name="IslandEditorMenuItem" Header="LBA2: island _terrain editor (Build mode)" Click="IslandEditor_Click"/>
                </MenuItem>
                <MenuItem Header="_Play" ToolTip.Tip="Plays a specific game's open scene regardless of which one the Game selector currently shows -- for the game that's already showing, the Play tab's own button does the same thing">
                    <MenuItem x:Name="Lba1PlayMenuItem" Header="LBA1: play _scene…" Click="Lba1Play_Click"/>
                    <MenuItem x:Name="Lba2PlayMenuItem" Header="LBA2: play _scene (the full engine)…" Click="Lba2Play_Click"/>
                </MenuItem>
                <MenuItem Header="_Data fixes">
                    <MenuItem x:Name="Lba2FixScriptingMenuItem" Header="LBA2: Fi_x scripting errors…" Click="Lba2FixScriptingErrors_Click"/>
                    <MenuItem x:Name="Lba1SurpriseMenuItem" Header="LBA1: _Make surprise changes…" Click="Lba1SurpriseChanges_Click"/>
                </MenuItem>
                <MenuItem x:Name="Lba2RaceTrackMenuItem" Header="LBA2: _race track…" Click="Lba2RaceTrack_Click" ToolTip.Tip="Builds race tracks, one island&apos;s or several at once (levelled, banked road, pit lane, start gantry, a bridge or a jump where the lap crosses itself), or puts the folder back. Play races the track of the island that is open"/>
                <Separator/>
                <MenuItem Header="_Test edits" ToolTip.Tip="Try changes against a scratch copy of the game folder before any of them touch your real files">
                    <MenuItem x:Name="TestEditsStartMenuItem" Header="_Start testing…" Click="TestEditsStart_Click"/>
                    <MenuItem x:Name="TestEditsCommitMenuItem" Header="_Commit test edits to the game folder…" Click="TestEditsCommit_Click"/>
                    <MenuItem x:Name="TestEditsDiscardMenuItem" Header="_Discard test edits" Click="TestEditsDiscard_Click"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Every panel's actual content, hidden here and wired into LayoutHost's DockGroups once at
             startup (MainWindow.Docking.cs's BuildDockLayout): see DockGroup's own comment for why
             AvalonDock was replaced with a purpose-built control (it is WPF-only, and Avalonia has no
             counterpart either, so the port keeps that control rather than swapping docking libraries). -->
        <Grid x:Name="PanelContentPool" IsVisible="False" DockPanel.Dock="Top">
            <Grid x:Name="LocationPanelContent" Background="{DynamicResource ThemeWindowBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Game" Classes="FieldLabel" Margin="0,0,0,4"/>
                    <ComboBox x:Name="GameCombo" Classes="DropdownBox" Width="84" Padding="8,4" SelectionChanged="GameCombo_SelectionChanged">
                        <ComboBoxItem Content="LBA1" Tag="1"/>
                        <ComboBoxItem Content="LBA2" Tag="2" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Island" Classes="FieldLabel" Margin="0,0,0,4"/>
                    <ComboBox x:Name="IslandCombo" Classes="DropdownBox" Width="170" Padding="8,4" IsEditable="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Scene" Classes="FieldLabel" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SceneCombo" Classes="DropdownBox" Width="300" Padding="8,4" IsEditable="True"/>
                </StackPanel>
                <CheckBox x:Name="JoinAreasCheck" Grid.Column="4" Content="Join connected areas" IsVisible="False" VerticalAlignment="Bottom" Margin="0,0,16,7"
                          Foreground="{DynamicResource ThemeTextBrush}" Click="JoinAreas_Click"
                          ToolTip.Tip="LBA1: show scenes that join edge to edge (an island's outdoor areas) as one continuous map"/>
                <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="DocumentTitle" Text="Island" FontSize="16" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DocumentSummary" Text="" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="ViewportPanelContent" Background="{DynamicResource ThemeWindowBrush}">
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                  <Grid>
                    <DockPanel x:Name="ViewToolbar" VerticalAlignment="Center">
                        <Button Content="▦" Click="Reset_Click" ToolTip.Tip="Reset view" Classes="IconButton"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox x:Name="RotateViewCheckBox" Content="Rotate/tilt with mouse" IsChecked="True" Foreground="{DynamicResource ThemeTextMuted2Brush}" FontFamily="{StaticResource EditorMonoFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox x:Name="SkyCheckBox" Content="Sky" IsChecked="True" Foreground="{DynamicResource ThemeTextMuted2Brush}" FontFamily="{StaticResource EditorMonoFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0" IsCheckedChanged="SkyCheckBox_Changed"/>
                            <Button Content="−" Click="ZoomOut_Click" Classes="IconButton"/>
                            <TextBox x:Name="ZoomLabel" Text="100%" FontFamily="{StaticResource EditorMonoFont}" FontSize="10" VerticalAlignment="Center" Margin="8,0" Width="40" TextAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextMuted2Brush}" KeyDown="ZoomLabel_KeyDown" LostFocus="ZoomLabel_LostFocus" GotFocus="ZoomLabel_GotFocus"/>
                            <Button Content="+" Click="ZoomIn_Click" Classes="IconButton"/>
                        </StackPanel>
                    </DockPanel>
                  </Grid>
                </Border>
                <Border x:Name="SceneViewBorder" Grid.Row="1" Background="{DynamicResource ThemeWindowBrush}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                        <Grid x:Name="ViewportHost" Grid.Row="0" Grid.Column="0" ClipToBounds="True" SizeChanged="ViewportHost_SizeChanged" PointerWheelChanged="TerrainViewport_MouseWheel" PointerExited="Viewport_MouseLeave"
                              PointerPressed="TerrainViewport_MouseDown" PointerMoved="TerrainViewport_MouseMove" PointerReleased="TerrainViewport_MouseUp">
                            <Image x:Name="TerrainViewport" Stretch="Fill" SizeChanged="TerrainViewport_SizeChanged" ClipToBounds="True" />
                            <Canvas x:Name="InteriorHost" Background="Black" IsVisible="False" ClipToBounds="True">
                                <Image x:Name="InteriorViewImage" Stretch="None"/>
                            </Canvas>
                            <Canvas x:Name="ActorMarkerCanvas" IsHitTestVisible="True"/>
                            <Canvas x:Name="BrushOverlayCanvas" IsHitTestVisible="False"/>
                            <Canvas x:Name="PlacementCanvas"/>
                        </Grid>
                        <ScrollBar x:Name="PanVerticalScrollBar" Grid.Row="0" Grid.Column="1" Orientation="Vertical"
                                   SmallChange="8192" LargeChange="65536"
                                   Scroll="PanVerticalScrollBar_Scroll"/>
                        <ScrollBar x:Name="PanHorizontalScrollBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                                   SmallChange="8192" LargeChange="65536"
                                   Scroll="PanHorizontalScrollBar_Scroll"/>
                    </Grid>
                </Border>
                <Border x:Name="TerrainMapHost" Grid.Row="1" Background="{DynamicResource ThemeFieldBrush}" ClipToBounds="True" IsVisible="False"/>
                <DockPanel Grid.Row="2" Background="{DynamicResource ThemeWindowBrush}" LastChildFill="True" Margin="16,0">
                    <StackPanel x:Name="BusyPanel" Orientation="Horizontal" DockPanel.Dock="Right" IsVisible="False" Margin="0,0,4,0" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="8" Margin="0,0,8,0"/>
                        <TextBlock x:Name="BusyLabel" Text="Working…" FontFamily="{StaticResource EditorMonoFont}" FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="FileLabel" Text="" FontFamily="{StaticResource EditorMonoFont}" FontSize="10" Foreground="{DynamicResource ThemeDisabledBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <!-- while a scene is played: the game (LBA2's engine, or the LBA1 play view) takes the viewer's place; the side panels stay -->
                <Border x:Name="PlayOverlay" Grid.Row="0" Grid.RowSpan="3" IsVisible="False" Background="Black" ZIndex="50" ClipToBounds="True">
                    <Border x:Name="PlayHostBorder" Background="Black" ClipToBounds="True"/>
                </Border>
            </Grid>
            <StackPanel x:Name="ModePanelContent" Background="{DynamicResource ThemeWindowBrush}" Margin="16,12,16,10">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="ModeExploreButton" Content="Explore" GroupName="mode" IsChecked="True" Classes="ModeButton" IsCheckedChanged="Mode_Checked" Tag="0"
                                 ToolTip.Tip="Just look: move the scene around, select actors and zones. Nothing can be changed here. (Ctrl+1)"/>
                    <RadioButton x:Name="ModeBuildButton" Content="Build" GroupName="mode" Classes="ModeButton" IsCheckedChanged="Mode_Checked" Tag="1"
                                 ToolTip.Tip="Make the changes: terrain, light and shadows, ground, objects, actors and zones. (Ctrl+2)"/>
                    <RadioButton x:Name="ModeScriptButton" Content="Script" GroupName="mode" Classes="ModeButton" IsCheckedChanged="Mode_Checked" Tag="2"
                                 ToolTip.Tip="Edit the actors' scripts: click an actor to open its script. (Ctrl+3)"/>
                </UniformGrid>
            </StackPanel>
            <ScrollViewer x:Name="ZonesPanelContent" VerticalScrollBarVisibility="Auto" Background="{DynamicResource ThemeWindowBrush}">
                <StackPanel Margin="20,18,20,18">
                    <CheckBox x:Name="ZoneMasterCheck" Content="Show scene zones" IsChecked="True" Foreground="{DynamicResource ThemeTextBrush}" Click="ZoneMaster_Click"/>
                    <CheckBox x:Name="PathsCheck" Content="Show actor paths" IsChecked="True" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10,0,0" Click="Paths_Click"/>
                    <CheckBox x:Name="HighlightCheck" Content="Highlight selected actor / zone" IsChecked="True" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10,0,0" Click="Highlight_Click"/>
                    <CheckBox x:Name="HideDummyActorsCheck" Content="Hide dummy (bodyless) actor markers" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10,0,0" Click="HideDummyActors_Click"/>
                    <CheckBox x:Name="HideAllActorsCheck" Content="Hide all actors" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10,0,0" Click="HideAllActors_Click"/>
                    <Separator Margin="0,14,0,14"/>
                    <TextBlock Text="Zone types" Classes="Eyebrow" Margin="0,0,0,10"/>
                    <StackPanel x:Name="ZoneTypeList"/>
                    <Separator Margin="0,14,0,14"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="↻" Width="24" Height="20" Padding="0" Classes="IconButton" ToolTip.Tip="Refresh the list from what is in view" Click="ActorsInViewRefresh_Click"/>
                        <TextBlock x:Name="ActorsInViewHeader" Text="Actors in view" Classes="Eyebrow" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="ActorsInViewList" Height="160" Background="{DynamicResource ThemeFieldBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="{StaticResource EditorMonoFont}" FontSize="11"
                             SelectionChanged="ActorsInViewList_SelectionChanged" DoubleTapped="ActorsInViewList_DoubleClick" ToolTip.Tip="Double-click to open the actor's attributes">
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="DetailsPanelContent" Margin="16,14,16,10" Background="{DynamicResource ThemeWindowBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="104"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="↻" Width="24" Height="20" Padding="0" Classes="IconButton" ToolTip.Tip="Refresh the list from what is in view" Click="ZoneListRefresh_Click"/>
                    <TextBlock x:Name="ZoneListHeader" Text="Zones in view" Classes="Eyebrow" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="ZoneListBox" Grid.Row="1" Background="{DynamicResource ThemeFieldBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="{StaticResource EditorMonoFont}" FontSize="11"
                         SelectionChanged="ZoneList_SelectionChanged">
                </ListBox>
                <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="ZoneNoSelection" Text="Click a zone's outline in the map, or pick one from the list, to see and change its data." TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThemeDisabledBrush}" FontFamily="{StaticResource EditorMonoFont}" FontSize="10"/>
                        <StackPanel x:Name="ZoneDetails" IsVisible="False">
                            <TextBlock x:Name="ZoneTitle" FontSize="15"/>
                            <TextBlock x:Name="ZoneSubtitle" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,10"/>

                            <TextBlock Text="Bounds (scene units)" Classes="Eyebrow" Margin="0,0,0,4"/>
                            <UniformGrid Columns="3" Margin="0,0,0,2">
                                <StackPanel Margin="0,0,4,0"><TextBlock Text="Min X" Classes="Eyebrow"/><TextBox x:Name="MinXBox" Classes="FieldBox" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                                <StackPanel Margin="0,0,4,0"><TextBlock Text="Min Y" Classes="Eyebrow"/><TextBox x:Name="MinYBox" Classes="FieldBox" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                                <StackPanel><TextBlock Text="Min Z" Classes="Eyebrow"/><TextBox x:Name="MinZBox" Classes="FieldBox" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="3" Margin="0,4,0,4">
                                <StackPanel Margin="0,0,4,0"><TextBlock Text="Max X" Classes="Eyebrow"/><TextBox x:Name="MaxXBox" Classes="FieldBox" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                                <StackPanel Margin="0,0,4,0"><TextBlock Text="Max Y" Classes="Eyebrow"/><TextBox x:Name="MaxYBox" Classes="FieldBox" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                                <StackPanel><TextBlock Text="Max Z" Classes="Eyebrow"/><TextBox x:Name="MaxZBox" Classes="FieldBox" Padding="4,3" TextChanged="ZoneBounds_TextChanged"/></StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="ZoneSizeText" FontFamily="{StaticResource EditorMonoFont}" FontSize="11" Foreground="{DynamicResource ThemeTextBrush}" TextWrapping="Wrap" Margin="0,2,0,12"/>

                            <TextBlock x:Name="ZoneDataHeader" Text="Zone data" Classes="Eyebrow" Margin="0,0,0,4"/>
                            <StackPanel x:Name="ZoneFieldsPanel"/>
                            <TextBlock x:Name="ZoneDestinationText" FontSize="11" Foreground="{DynamicResource ThemeAccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="ZoneApplyButton" Content="Apply" Classes="PrimaryButton" Padding="14,6" Click="ZoneApply_Click" ToolTip.Tip="Write these values into SCENE.HQR (the first save keeps SCENE.HQR.bak)"/>
                                <Button x:Name="ZoneRevertButton" Content="Revert" Classes="QuietButton" Padding="12,6" Margin="8,0,0,0" Click="ZoneRevert_Click"/>
                                <Button x:Name="ZoneGotoButton" Content="Go to destination" Classes="QuietButton" Padding="10,6" Margin="8,0,0,0" Click="ZoneGoto_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ZoneStatus" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="BuildPanelContent" Background="{DynamicResource ThemeWindowBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10,16,12">
                    <Button x:Name="NukeButton" Content="☢  Nuke this scene…" Classes="QuietButton" HorizontalContentAlignment="Left" Padding="10,6"
                            Foreground="{DynamicResource ThemeWarningBrush}" BorderBrush="{DynamicResource ThemeWarningBrush}" Click="Nuke_Click"
                            ToolTip.Tip="Blow up everything in the scene that is open -- its actors, zones, points, buildings and decor -- and leave a flat, empty scene with Twinsen standing on it. The scene's exits to other scenes are kept. Saved straight away; Edit > Undo brings it all back"/>
                </Border>
                <StackPanel x:Name="BuildViewBar" Grid.Row="0" Margin="16,12,16,2">
                    <TextBlock Text="What to edit" Classes="Eyebrow" Margin="0,0,0,6"/>
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton x:Name="BuildTerrainRadio" Content="Terrain" GroupName="buildview" IsChecked="True" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,16,4" IsCheckedChanged="BuildView_Changed"
                                     ToolTip.Tip="Sculpt the island in the 3D view, live: heights, levelling, baked light and shadows, ground, objects"/>
                        <RadioButton x:Name="BuildDecorRadio" Content="Buildings and decor" GroupName="buildview" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,16,4" IsCheckedChanged="BuildView_Changed"
                                     ToolTip.Tip="Place, move and turn the island's buildings, trees and other objects in the 3D view, live"/>
                        <RadioButton x:Name="BuildSceneRadio" Content="Actors and zones" GroupName="buildview" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,4" IsCheckedChanged="BuildView_Changed"
                                     ToolTip.Tip="Add and edit actors and zones in the 3D view"/>
                    </WrapPanel>
                </StackPanel>
                <ContentControl x:Name="TerrainPanelHost" Grid.Row="1"/>
                <ScrollViewer x:Name="BuildScenePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <StackPanel Margin="16,10,16,16">
                        <TextBlock x:Name="BuildSceneHelp" TextWrapping="Wrap" FontFamily="{StaticResource EditorMonoFont}" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted2Brush}"/>
                        <TextBlock Text="Editors" Classes="Eyebrow" Margin="0,16,0,6"/>
                        <Button x:Name="BuildSceneEditorButton" Content="Scene editor (actors, zones, points)…" Classes="QuietButton" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,6" Click="BuildSceneEditor_Click"/>
                        <Button x:Name="BuildGridButton" Content="Buildings and decor: interior map (grid editor)…" Classes="QuietButton" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,6" Click="GridEditor_Click"
                                ToolTip.Tip="Place, move, copy and remove the blocks (buildings, walls, furniture) of an interior or an LBA1 scene. Buildings on an LBA2 island are placed, moved and turned in the 3D view: pick the island, then Build > Buildings and decor"/>
                        <Button x:Name="BuildAssetButton" Content="Bricks and sprites…" Classes="QuietButton" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,6" Click="AssetEditor_Click"/>
                        <Button x:Name="BuildExportButton" Content="Export 3D models (glTF, OBJ, PLY, STL)…" Classes="QuietButton" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,6" Click="Export3D_Click"
                                ToolTip.Tip="Export islands, buildings, interiors, actors, bodies, furniture and items to common 3D formats (for other tools, not for the game)"/>
                        <Button x:Name="BuildObjectButton" Content="Objects and bodies…" Classes="QuietButton" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,6" Click="ObjectBrowser_Click"/>
                        <Button Content="Body Studio…" Classes="QuietButton" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,6" Click="BodyStudio_Click"/>
                        <Button Content="Animation Studio…" Classes="QuietButton" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,6" Click="AnimationStudio_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="PlayPanelContent" VerticalScrollBarVisibility="Auto" Background="{DynamicResource ThemeWindowBrush}">
                <StackPanel Margin="20,16,20,16">
                    <TextBlock x:Name="PlayIntro" Text="Play a scene" Classes="Eyebrow"/>
                    <TextBlock x:Name="PlayIntroText" TextWrapping="Wrap" FontFamily="{StaticResource EditorMonoFont}" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted2Brush}" Margin="0,8,0,12"/>
                    <Button x:Name="PlayButton" Content="▶  Play scene" Classes="PrimaryButton" Padding="14,10" HorizontalAlignment="Stretch" Click="PlayScene_Click"/>
                    <StackPanel x:Name="PlayRunningPanel" Orientation="Horizontal" IsVisible="False">
                        <Button x:Name="StopPlayButton" Content="■  Stop" Classes="PrimaryButton" Padding="18,10" Click="StopPlay_Click" ToolTip.Tip="End the game and go back to the editor"/>
                        <Button x:Name="RestartPlayButton" Content="↻  Restart" Classes="QuietButton" Padding="14,10" Margin="8,0,0,0" Click="RestartPlay_Click" ToolTip.Tip="Start the scene again from the beginning"/>
                    </StackPanel>
                    <CheckBox x:Name="PlacementCheck" Content="Choose where Twinsen starts" IsChecked="True" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10,0,0"
                              ToolTip.Tip="Pressing Play first shows the scene with Twinsen on it: drag him where you want him and let go to start the game there"/>
                    <TextBlock x:Name="PlayStatus" TextWrapping="Wrap" FontFamily="{StaticResource EditorMonoFont}" FontSize="10.5" Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,8,0,4"/>
                    <TextBlock x:Name="AudioHeading" Text="Sound" Classes="Eyebrow" Margin="0,0,0,6"/>
                    <CheckBox x:Name="AudioMuteCheck" Content="Mute all sound" Foreground="{DynamicResource ThemeTextBrush}" Click="AudioMute_Click"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Music" Classes="Eyebrow" VerticalAlignment="Center"/>
                        <Slider x:Name="AudioMusicSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center" ValueChanged="AudioSlider_Changed" ToolTip.Tip="The game's music"/>
                        <TextBlock x:Name="AudioMusicValue" Grid.Row="0" Grid.Column="2" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="{StaticResource EditorMonoFont}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
                        <TextBlock Grid.Row="1" Text="Voices" Classes="Eyebrow" VerticalAlignment="Center"/>
                        <Slider x:Name="AudioVoicesSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center" ValueChanged="AudioSlider_Changed" ToolTip.Tip="Spoken dialogue"/>
                        <TextBlock x:Name="AudioVoicesValue" Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="{StaticResource EditorMonoFont}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
                        <TextBlock Grid.Row="2" Text="Effects" Classes="Eyebrow" VerticalAlignment="Center"/>
                        <Slider x:Name="AudioEffectsSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center" ValueChanged="AudioSlider_Changed" ToolTip.Tip="Sound effects (footsteps, hits, doors ...)"/>
                        <TextBlock x:Name="AudioEffectsValue" Grid.Row="2" Grid.Column="2" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="{StaticResource EditorMonoFont}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Reset balance" Classes="QuietButton" Padding="10,4" Click="AudioReset_Click" ToolTip.Tip="Music low, speech and effects up: the games' own balance drowns the speech"/>
                    </StackPanel>
                    <TextBlock x:Name="AudioNote" TextWrapping="Wrap" FontFamily="{StaticResource EditorMonoFont}" FontSize="10" Foreground="{DynamicResource ThemeDisabledBrush}" Margin="0,8,0,0"/>
                    <StackPanel x:Name="PlayEngineOptions">
                        <TextBlock Text="Console commands" Classes="Eyebrow" Margin="0,18,0,4"/>
                        <TextBox x:Name="PlayCommandsBox" Classes="FieldBox" Padding="6,4" AcceptsReturn="True" TextWrapping="Wrap" Height="96" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource EditorMonoFont}"
                                 ToolTip.Tip="One per line or separated by ';': give &lt;item&gt;, vargame &lt;n&gt; &lt;value&gt;, behaviour &lt;0..4&gt;, teleport &lt;x&gt; &lt;y&gt; &lt;z&gt;, weapon &lt;n&gt; ..."/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Every item" Classes="QuietButton" Padding="10,4" Click="PlayEveryItem_Click" ToolTip.Tip="Sets the inventory flags 0..40 (holomap, magic ball, sword, keys ...) with vargame"/>
                            <Button Content="Clear" Classes="QuietButton" Padding="10,4" Click="PlayClearCommands_Click"/>
                        </StackPanel>
                        <TextBlock Text="Things like `give`, `vargame 94 1`, `behaviour 2` or `teleport 24000 4096 6000` set Twinsen up. Nothing is saved: autosave is off and the game's saves live in a folder of their own." TextWrapping="Wrap" FontFamily="{StaticResource EditorMonoFont}" FontSize="10" Foreground="{DynamicResource ThemeDisabledBrush}" Margin="0,14,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="ScriptPanelContent" Margin="16,14,16,10" Background="{DynamicResource ThemeWindowBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="↻" Width="24" Height="20" Padding="0" Classes="IconButton" ToolTip.Tip="Refresh the list from what is in view" Click="ScriptActorsRefresh_Click"/>
                    <TextBlock x:Name="ScriptActorsHeader" Text="Actors in view" Classes="Eyebrow" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="ScriptHelp" Grid.Row="1" TextWrapping="Wrap" FontFamily="{StaticResource EditorMonoFont}" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted2Brush}" Margin="0,0,0,8"
                           Text="Click an actor in the view, or double-click one here, to open its script. Scripts stay in the editor until they are saved from their window."/>
                <ListBox x:Name="ScriptActorList" Grid.Row="2" Background="{DynamicResource ThemeFieldBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="{StaticResource EditorMonoFont}" FontSize="11"
                         DoubleTapped="ScriptActorList_DoubleClick" SelectionChanged="ScriptActorList_SelectionChanged">
                </ListBox>
            </Grid>
            <StackPanel x:Name="MinimapPanelContent" Background="{DynamicResource ThemeWindowBrush}">
                <Border x:Name="MinimapBody" Margin="20,14,20,14" Background="{DynamicResource ThemeFieldBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="4">
                    <ScrollViewer x:Name="MinimapScrollViewer" Width="222" Height="222" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="MinimapContent" Cursor="Hand" PointerPressed="Minimap_MouseDown" ToolTip.Tip="Double-click to pop out">
                            <Image x:Name="MinimapImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            <Canvas x:Name="MinimapActorCanvas" IsHitTestVisible="False"/>
                            <Canvas x:Name="MinimapMarkerCanvas" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
        <!-- Last child of the outer DockPanel so it FILLS the window. It used to sit above the collapsed pool,
             making the pool the fill child and LayoutHost merely dock-left at its desired width: the layout was
             only ever as wide as its content wanted (which happened to be nearly full width for LBA2 but left a
             big empty strip on the right once LBA1's narrower viewport content was showing). -->
        <DockPanel x:Name="LayoutHost" LastChildFill="True"/>
    </DockPanel>
</Window>
