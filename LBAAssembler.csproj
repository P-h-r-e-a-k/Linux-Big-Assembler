<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest></ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>LBAAssembler</AssemblyName>
    <RootNamespace>LBAAssembler</RootNamespace>
    <!-- The port targets Linux first; Avalonia itself also runs on Windows and macOS, so nothing here is Linux only. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The Linux Big Assembler is the Avalonia (cross-platform) port of the WPF editor: one UI stack for the editor and for
       Body Studio (BodyStudio/*.cs, formerly Windows Forms), no System.Drawing. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!-- tools/ holds separate console harnesses (each its own project); keep their sources and obj output out of the app. -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
    <AvaloniaXaml Remove="tools\**" />
    <Compile Remove="native\**" />
    <None Remove="native\**" />
    <AvaloniaXaml Remove="native\**" />
  </ItemGroup>

  <!--
    liblba2_renderer.so is built from native/lba2-classic-community with the "linux" CMake preset (see README) into
    out/build/linux. It is copied next to the executable on every build and embedded as a resource for a single file
    publish, exactly as the Windows build did with liblba2_renderer.dll (RendererLibraryApi extracts the embedded copy
    to a native/ folder next to the executable on first use).
  -->
  <PropertyGroup>
    <NativeRendererLinux>native/lba2-classic-community/out/build/linux/SOURCES/3DEXT/liblba2_renderer.so</NativeRendererLinux>
    <NativeEngineLinux>native/lba2-classic-community/out/build/linux/SOURCES/lba2cc</NativeEngineLinux>
    <NativeRendererWindows>native/lba2-classic-community/out/build/windows_ucrt64_static/SOURCES/3DEXT/liblba2_renderer.dll</NativeRendererWindows>
    <NativeEngineWindows>native/lba2-classic-community/out/build/windows_ucrt64_static/SOURCES/lba2cc.exe</NativeEngineWindows>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(NativeRendererLinux)" Condition="Exists('$(NativeRendererLinux)')" Link="liblba2_renderer.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="$(NativeRendererLinux)" Condition="Exists('$(NativeRendererLinux)')" LogicalName="liblba2_renderer.so" />
    <None Include="$(NativeEngineLinux)" Condition="Exists('$(NativeEngineLinux)')" Link="lba2cc" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="$(NativeEngineLinux)" Condition="Exists('$(NativeEngineLinux)')" LogicalName="lba2cc" />
    <None Include="$(NativeRendererWindows)" Condition="Exists('$(NativeRendererWindows)')" Link="liblba2_renderer.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="$(NativeRendererWindows)" Condition="Exists('$(NativeRendererWindows)')" LogicalName="liblba2_renderer.dll" />
    <EmbeddedResource Include="$(NativeEngineWindows)" Condition="Exists('$(NativeEngineWindows)')" LogicalName="lba2cc.exe" />
  </ItemGroup>

  <!-- Dummy body shown in the Actor Attributes preview panel for a freshly added actor (see ActorAttributesWindow's showingDummyBody). -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\DummyBody.lm2" LogicalName="DummyBody.lm2" />
  </ItemGroup>

  <!-- The human-readable scene/body/animation name lists (LBAPackageManager's .HQD text files) ship inside the executable. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\FileDesc\*.HQD" LogicalName="FileDesc.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
