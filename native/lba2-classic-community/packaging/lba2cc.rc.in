// Windows resource file. Generated at configure time from this template.
// Source of truth for product strings is the LBA2_* CMake cache variables
// in the root CMakeLists.txt — same source that feeds the runtime window
// title, the .desktop entry, and AppImage labels. Reconfigure after
// editing VERSION or after the working tree's dirty state changes to
// refresh the strings baked into the binary's Properties → Details.

#include <winver.h>

// Application icon — Windows picks numeric ID 1 as the .exe's default icon.
1 ICON "@CMAKE_SOURCE_DIR@/packaging/lba2cc.ico"

// The manifest (RT_MANIFEST 24, ID 1), in place of the toolchain's default one (default-manifest.o: the same trust level and
// supported systems; linked after this, so this is the one used), with the UTF-8 code page besides: SDL's main hands the program
// its command line as UTF-8, and the CRT's narrow file calls (stat, fopen) and getenv read paths in the process's code page. With
// the system's own (Cyrillic, Western), a game, user or race-file folder with any letter outside ASCII was "Invalid user
// directory" and the game ended before its window opened (2026-10-12). Windows 10 1903 and later; older ones ignore it.
// (No comments in lba2cc.manifest itself: an XML comment can't hold a double hyphen, and a bad manifest stops the program loading.)
1 24 "@CMAKE_SOURCE_DIR@/packaging/lba2cc.manifest"

1 VERSIONINFO
FILEVERSION    @LBA2_VERSION_TUPLE@
PRODUCTVERSION @LBA2_VERSION_TUPLE@
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      @LBA2_VERSIONINFO_FLAGS@
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904E4 = English (US), Windows Multilingual code page.
        BLOCK "040904E4"
        BEGIN
            VALUE "ProductName",      "@LBA2_PRODUCT_NAME@"
            VALUE "FileDescription",  "@LBA2_PRODUCT_DESCRIPTION@"
            VALUE "OriginalFilename", "@LBA2_EXECUTABLE_NAME@.exe"
            VALUE "InternalName",     "@LBA2_EXECUTABLE_NAME@"
            VALUE "ProductVersion",   "@LBA2_VERSION_STRING_CONFIG@"
            VALUE "FileVersion",      "@LBA2_VERSION_STRING_CONFIG@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04E4
    END
END
