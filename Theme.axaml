<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The editor's light blue scheme (shared with a sister project): window #E8F0FA, surfaces #F3F8FF, text #10243E, borders #A9C3E0,
         accent / selection #1B6EC2 with white text, buttons #D6E6F7 (hover #C3DBF5, border #9FBEE0), inputs and lists #FFFFFF, alternate rows
         #EAF3FD, headers #D2E3F6, menus and the status bar #DCEAFA, muted text #4E6B8A / #234A72, disabled text #7C93AC, warning #A32C22,
         good #14664A. The window XAML files carry the same values inline; this file themes what they leave to the toolkit (Avalonia's
         Fluent theme underneath): buttons, combo boxes and their lists, lists, tabs, tool tips and menus, plus the named looks the windows
         share (QuietButton, PrimaryButton, IconButton, ToolButton, Eyebrow, FieldLabel, FieldBox, DropdownBox, ModeButton, ViewTab):
         WPF's keyed styles, which are Avalonia style classes. -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- The fonts: the Windows names first (a Windows machine keeps its look), then what fontconfig resolves on Linux. -->
            <FontFamily x:Key="EditorFont">Segoe UI, Noto Sans, DejaVu Sans, Liberation Sans, sans-serif</FontFamily>
            <FontFamily x:Key="EditorMonoFont">Consolas, DejaVu Sans Mono, Liberation Mono, Noto Sans Mono, monospace</FontFamily>

            <Color x:Key="ThemeField">#FFFFFF</Color>
            <Color x:Key="ThemeWindow">#E8F0FA</Color>
            <Color x:Key="ThemeSurface">#F3F8FF</Color>
            <Color x:Key="ThemeRaised">#D6E6F7</Color>
            <Color x:Key="ThemeHover">#C3DBF5</Color>
            <Color x:Key="ThemeSelected">#1B6EC2</Color>
            <Color x:Key="ThemeBorder">#A9C3E0</Color>
            <Color x:Key="ThemeButtonBorder">#9FBEE0</Color>
            <Color x:Key="ThemeBorderStrong">#8FB0D6</Color>
            <Color x:Key="ThemeText">#10243E</Color>
            <Color x:Key="ThemeTextMuted">#4E6B8A</Color>
            <Color x:Key="ThemeDisabled">#7C93AC</Color>
            <Color x:Key="ThemeAccent">#1B6EC2</Color>
            <Color x:Key="ThemeMenu">#DCEAFA</Color>
            <Color x:Key="ThemeRowEven">#EAF3FD</Color>
            <Color x:Key="ThemeHeader">#D2E3F6</Color>

            <SolidColorBrush x:Key="ThemeFieldBrush" Color="{StaticResource ThemeField}"/>
            <SolidColorBrush x:Key="ThemeWindowBrush" Color="{StaticResource ThemeWindow}"/>
            <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{StaticResource ThemeSurface}"/>
            <SolidColorBrush x:Key="ThemeRaisedBrush" Color="{StaticResource ThemeRaised}"/>
            <SolidColorBrush x:Key="ThemeHoverBrush" Color="{StaticResource ThemeHover}"/>
            <SolidColorBrush x:Key="ThemeSelectedBrush" Color="{StaticResource ThemeSelected}"/>
            <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorder}"/>
            <SolidColorBrush x:Key="ThemeButtonBorderBrush" Color="{StaticResource ThemeButtonBorder}"/>
            <SolidColorBrush x:Key="ThemeBorderStrongBrush" Color="{StaticResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="ThemeTextBrush" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="{StaticResource ThemeTextMuted}"/>
            <SolidColorBrush x:Key="ThemeDisabledBrush" Color="{StaticResource ThemeDisabled}"/>
            <SolidColorBrush x:Key="ThemeAccentBrush" Color="{StaticResource ThemeAccent}"/>
            <SolidColorBrush x:Key="ThemeMenuBrush" Color="{StaticResource ThemeMenu}"/>
            <SolidColorBrush x:Key="ThemeRowEvenBrush" Color="{StaticResource ThemeRowEven}"/>
            <SolidColorBrush x:Key="ThemeHeaderBrush" Color="{StaticResource ThemeHeader}"/>

            <!-- What the Fluent templates draw with (the resource names are Fluent's own). -->
            <Color x:Key="SystemAccentColor">#1B6EC2</Color>
            <Color x:Key="SystemAccentColorDark1">#1760A8</Color>
            <Color x:Key="SystemAccentColorDark2">#12508C</Color>
            <Color x:Key="SystemAccentColorDark3">#0E4070</Color>
            <Color x:Key="SystemAccentColorLight1">#3A82CC</Color>
            <Color x:Key="SystemAccentColorLight2">#5A97D6</Color>
            <Color x:Key="SystemAccentColorLight3">#7AACDF</Color>
            <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource ThemeField}"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource ThemeField}"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource ThemeField}"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource ThemeBorder}"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource ThemeAccent}"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource ThemeDisabled}"/>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource ThemeMenu}"/>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="{StaticResource ThemeDisabled}"/>
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPointerOver" Color="{StaticResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="{StaticResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuFlyoutSubItemForeground" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPointerOver" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundSubMenuOpened" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{StaticResource ThemeTextMuted}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemChevron" Color="{StaticResource ThemeTextMuted}"/>
            <SolidColorBrush x:Key="MenuBarItemBackgroundPointerOver" Color="{StaticResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="{StaticResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="{StaticResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuBarItemForeground" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuBarItemForegroundPointerOver" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuBarItemForegroundPressed" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuBarItemForegroundSelected" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource ThemeField}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource ThemeField}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource ThemeField}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource ThemeField}"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource ThemeBorder}"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource ThemeField}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource ThemeTextMuted}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource ThemeHover}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource ThemeSelected}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource ThemeSelected}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{StaticResource ThemeSelected}"/>
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource ThemeText}"/>
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource ThemeSurface}"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource ThemeText}"/>
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource ThemeBorder}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{StaticResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{StaticResource ThemeAccent}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="{StaticResource ThemeRowEven}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{StaticResource ThemeRowEven}"/>
            <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource ThemeBorder}"/>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource ThemeBorderStrong}"/>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource EditorFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource ThemeWindowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
    </Style>

    <!-- Buttons: the button's own Background / BorderBrush / Foreground, with a darker wash over it while the mouse is on it or it is pressed. -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource ThemeRaisedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
                    <Border Name="Wash" Background="#10243E" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}"/>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ Border#Wash"><Setter Property="Opacity" Value="0.08"/></Style>
    <Style Selector="Button:pressed /template/ Border#Wash"><Setter Property="Opacity" Value="0.16"/></Style>
    <Style Selector="Button:focus-visible /template/ Border#Bd"><Setter Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
    <Style Selector="RepeatButton">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- The named looks the windows share. -->
    <Style Selector="Button.QuietButton">
        <Setter Property="Foreground" Value="#10243E"/>
        <Setter Property="Background" Value="#D6E6F7"/>
        <Setter Property="BorderBrush" Value="#A9C3E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,9"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style Selector="Button.PrimaryButton">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="#1B6EC2"/>
        <Setter Property="BorderBrush" Value="#1B6EC2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Button.IconButton">
        <Setter Property="Foreground" Value="#234A72"/>
        <Setter Property="Background" Value="#D6E6F7"/>
        <Setter Property="BorderBrush" Value="#A9C3E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.ToolButton">
        <Setter Property="Foreground" Value="#10243E"/>
        <Setter Property="Background" Value="#D6E6F7"/>
        <Setter Property="BorderBrush" Value="#A9C3E0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Style Selector="Button.ToolButton:pointerover /template/ Border#Bd"><Setter Property="BorderBrush" Value="#4E6B8A"/></Style>
    <Style Selector="Button.ToolButton:disabled"><Setter Property="Foreground" Value="#8FB0D6"/><Setter Property="Opacity" Value="1"/></Style>
    <!-- The island terrain editor's tool buttons (IslandEditorView): the hover colour as the face, the border colour when pressed. -->
    <Style Selector="Button.MapTool">
        <Setter Property="Foreground" Value="#10243E"/>
        <Setter Property="Background" Value="#C3DBF5"/>
        <Setter Property="BorderBrush" Value="#A9C3E0"/>
        <Setter Property="Padding" Value="9,3"/>
    </Style>
    <Style Selector="Button.MapTool:pressed /template/ Border#Bd"><Setter Property="Background" Value="#A9C3E0"/></Style>
    <Style Selector="TextBlock.Eyebrow">
        <Setter Property="Foreground" Value="#4E6B8A"/>
        <Setter Property="FontFamily" Value="{StaticResource EditorMonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="Foreground" Value="#4E6B8A"/>
        <Setter Property="FontFamily" Value="{StaticResource EditorMonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style Selector="TextBlock.Caption">
        <Setter Property="Foreground" Value="#4E6B8A"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="0,8,0,3"/>
    </Style>
    <Style Selector=":is(TemplatedControl).FieldBox, :is(TemplatedControl).DropdownBox">
        <Setter Property="Foreground" Value="#10243E"/>
        <Setter Property="Background" Value="#E8F0FA"/>
        <Setter Property="BorderBrush" Value="#A9C3E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="TextBox.FieldBox:pointerover /template/ Border#PART_BorderElement, TextBox.FieldBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#E8F0FA"/>
    </Style>
    <Style Selector="TextBox.FieldBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="#1B6EC2"/></Style>
    <Style Selector="ComboBox.DropdownBox:pointerover /template/ Border#Background, ComboBox.DropdownBox:focus /template/ Border#Background">
        <Setter Property="Background" Value="#E8F0FA"/>
    </Style>

    <!-- The mode chips of the main window and the Life / Track switch of the script window. -->
    <Style Selector="RadioButton.ModeButton">
        <Setter Property="Foreground" Value="#234A72"/>
        <Setter Property="FontFamily" Value="{StaticResource EditorMonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Chip" Padding="14,7" Background="#D6E6F7" BorderBrush="#A9C3E0" BorderThickness="1" Margin="0,0,-1,0">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.ModeButton:pointerover /template/ Border#Chip"><Setter Property="Background" Value="#C3DBF5"/></Style>
    <Style Selector="RadioButton.ModeButton:checked /template/ Border#Chip"><Setter Property="Background" Value="#1B6EC2"/><Setter Property="BorderBrush" Value="#1B6EC2"/></Style>
    <Style Selector="RadioButton.ModeButton:checked"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="RadioButton.ViewTab">
        <Setter Property="Foreground" Value="#234A72"/>
        <Setter Property="Background" Value="#E8F0FA"/>
        <Setter Property="BorderBrush" Value="#A9C3E0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,-1,0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12,4">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.ViewTab:checked /template/ Border#Chrome"><Setter Property="Background" Value="#C3DBF5"/></Style>
    <Style Selector="RadioButton.ViewTab:checked"><Setter Property="Foreground" Value="#10243E"/><Setter Property="ZIndex" Value="1"/></Style>
    <Style Selector="RadioButton.ViewTab:disabled"><Setter Property="Foreground" Value="#8FB0D6"/></Style>
    <Style Selector="RadioButton.ViewTab:pointerover /template/ Border#Chrome"><Setter Property="BorderBrush" Value="#7C93AC"/></Style>

    <!-- Menus: the bar in the menu colour, no tick / icon column beyond what Fluent draws. -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="{StaticResource ThemeMenuBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
    </Style>
    <Style Selector="Menu > MenuItem">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{StaticResource ThemeMenuBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="0,4"/>
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MaxWidth" Value="420"/>
    </Style>

    <!-- Inputs: square, in the field colour. -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource ThemeFieldBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="CaretBrush" Value="{StaticResource ThemeTextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource ThemeSelectedBrush}"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource ThemeFieldBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="{StaticResource ThemeFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource ThemeHoverBrush}"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ThemeSelectedBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource ThemeSelectedBrush}"/></Style>
    <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource ThemeSelectedBrush}"/></Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="{StaticResource ThemeBorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeAccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource ThemeBorderBrush}"/>
    </Style>

    <!-- Tabs: a raised chip, lighter when selected. (The main window styles its own, see MainWindow.axaml.) -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="#234A72"/>
        <Setter Property="Background" Value="{StaticResource ThemeRaisedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#Bd"><Setter Property="Background" Value="{StaticResource ThemeHoverBrush}"/></Style>
    <Style Selector="TabItem:selected /template/ Border#Bd"><Setter Property="Background" Value="{StaticResource ThemeFieldBrush}"/></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}"/></Style>
</Styles>
