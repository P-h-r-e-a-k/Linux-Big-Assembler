<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The editor's shared looks. The colours themselves are no longer here: each theme is its own dictionary in Themes/*.axaml
         (Light is the original light blue scheme), swapped in at run time by ThemeManager. Everything below therefore refers to a
         colour with {DynamicResource ThemeXxx}, never {StaticResource}, so switching theme re-resolves it instead of leaving the
         old colour baked in from load time.
         What this file themes is whatever the windows leave to the toolkit (Avalonia's Fluent theme underneath): buttons, combo
         boxes and their lists, lists, tabs, tool tips and menus (the Fluent key overrides further down), plus the named looks the
         windows share (QuietButton, PrimaryButton, IconButton, ToolButton, Eyebrow, FieldLabel, FieldBox, DropdownBox, ModeButton,
         ViewTab): WPF's keyed styles, which are Avalonia style classes. -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- The fonts: the Windows names first (a Windows machine keeps its look), then what fontconfig resolves on Linux. -->
            <FontFamily x:Key="EditorFont">Segoe UI, Noto Sans, DejaVu Sans, Liberation Sans, sans-serif</FontFamily>
            <FontFamily x:Key="EditorMonoFont">Consolas, DejaVu Sans Mono, Liberation Mono, Noto Sans Mono, monospace</FontFamily>

            <!-- What the Fluent templates draw with (the resource names are Fluent's own). -->
            <Color x:Key="SystemAccentColor">#1B6EC2</Color>
            <Color x:Key="SystemAccentColorDark1">#1760A8</Color>
            <Color x:Key="SystemAccentColorDark2">#12508C</Color>
            <Color x:Key="SystemAccentColorDark3">#0E4070</Color>
            <Color x:Key="SystemAccentColorLight1">#3A82CC</Color>
            <Color x:Key="SystemAccentColorLight2">#5A97D6</Color>
            <Color x:Key="SystemAccentColorLight3">#7AACDF</Color>
            <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource ThemeField}"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource ThemeField}"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource ThemeField}"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource ThemeBorder}"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource ThemeAccent}"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource ThemeDisabled}"/>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{DynamicResource ThemeMenu}"/>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{DynamicResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{DynamicResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{DynamicResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="{DynamicResource ThemeDisabled}"/>
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPointerOver" Color="{DynamicResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="{DynamicResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuFlyoutSubItemForeground" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPointerOver" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundSubMenuOpened" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{DynamicResource ThemeTextMuted}"/>
            <SolidColorBrush x:Key="MenuFlyoutItemChevron" Color="{DynamicResource ThemeTextMuted}"/>
            <SolidColorBrush x:Key="MenuBarItemBackgroundPointerOver" Color="{DynamicResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="{DynamicResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="{DynamicResource ThemeHover}"/>
            <SolidColorBrush x:Key="MenuBarItemForeground" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuBarItemForegroundPointerOver" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuBarItemForegroundPressed" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="MenuBarItemForegroundSelected" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource ThemeField}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource ThemeField}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource ThemeField}"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{DynamicResource ThemeField}"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource ThemeBorder}"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{DynamicResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource ThemeField}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{DynamicResource ThemeTextMuted}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{DynamicResource ThemeHover}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{DynamicResource ThemeSelected}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{DynamicResource ThemeSelected}"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{DynamicResource ThemeSelected}"/>
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{DynamicResource ThemeAccentText}"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{DynamicResource ThemeAccentText}"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="{DynamicResource ThemeAccentText}"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{DynamicResource ThemeText}"/>
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <SolidColorBrush x:Key="ToolTipBackground" Color="{DynamicResource ThemeSurface}"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="{DynamicResource ThemeText}"/>
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{DynamicResource ThemeBorder}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{DynamicResource ThemeBorderStrong}"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{DynamicResource ThemeAccent}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="{DynamicResource ThemeRowEven}"/>
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{DynamicResource ThemeRowEven}"/>
            <SolidColorBrush x:Key="SliderTrackFill" Color="{DynamicResource ThemeBorder}"/>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{DynamicResource ThemeBorderStrong}"/>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource EditorFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource ThemeWindowBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
    </Style>

    <!-- Buttons: the button's own Background / BorderBrush / Foreground, with a darker wash over it while the mouse is on it or it is pressed. -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource ThemeRaisedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
                    <Border Name="Wash" Background="{DynamicResource ThemeTextBrush}" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}"/>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ Border#Wash"><Setter Property="Opacity" Value="0.08"/></Style>
    <Style Selector="Button:pressed /template/ Border#Wash"><Setter Property="Opacity" Value="0.16"/></Style>
    <Style Selector="Button:focus-visible /template/ Border#Bd"><Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
    <Style Selector="RepeatButton">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- The named looks the windows share. -->
    <Style Selector="Button.QuietButton">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,9"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style Selector="Button.PrimaryButton">
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Button.IconButton">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted2Brush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.ToolButton">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Style Selector="Button.ToolButton:pointerover /template/ Border#Bd"><Setter Property="BorderBrush" Value="{DynamicResource ThemeTextMutedBrush}"/></Style>
    <Style Selector="Button.ToolButton:disabled"><Setter Property="Foreground" Value="{DynamicResource ThemeBorderStrongBrush}"/><Setter Property="Opacity" Value="1"/></Style>
    <!-- The island terrain editor's tool buttons (IslandEditorView): the hover colour as the face, the border colour when pressed. -->
    <Style Selector="Button.MapTool">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="Padding" Value="9,3"/>
    </Style>
    <Style Selector="Button.MapTool:pressed /template/ Border#Bd"><Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}"/></Style>
    <Style Selector="TextBlock.Eyebrow">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource EditorMonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource EditorMonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style Selector="TextBlock.Caption">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="0,8,0,3"/>
    </Style>
    <Style Selector=":is(TemplatedControl).FieldBox, :is(TemplatedControl).DropdownBox">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeWindowBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="TextBox.FieldBox:pointerover /template/ Border#PART_BorderElement, TextBox.FieldBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ThemeWindowBrush}"/>
    </Style>
    <Style Selector="TextBox.FieldBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/></Style>
    <Style Selector="ComboBox.DropdownBox:pointerover /template/ Border#Background, ComboBox.DropdownBox:focus /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource ThemeWindowBrush}"/>
    </Style>

    <!-- The mode chips of the main window and the Life / Track switch of the script window. -->
    <Style Selector="RadioButton.ModeButton">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted2Brush}"/>
        <Setter Property="FontFamily" Value="{StaticResource EditorMonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Chip" Padding="14,7" Background="{DynamicResource ThemeRaisedBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Margin="0,0,-1,0">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.ModeButton:pointerover /template/ Border#Chip"><Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}"/></Style>
    <Style Selector="RadioButton.ModeButton:checked /template/ Border#Chip"><Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/></Style>
    <Style Selector="RadioButton.ModeButton:checked"><Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="RadioButton.ViewTab">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted2Brush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeWindowBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,-1,0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12,4">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.ViewTab:checked /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}"/></Style>
    <Style Selector="RadioButton.ViewTab:checked"><Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/><Setter Property="ZIndex" Value="1"/></Style>
    <Style Selector="RadioButton.ViewTab:disabled"><Setter Property="Foreground" Value="{DynamicResource ThemeBorderStrongBrush}"/></Style>
    <Style Selector="RadioButton.ViewTab:pointerover /template/ Border#Chrome"><Setter Property="BorderBrush" Value="{DynamicResource ThemeDisabledBrush}"/></Style>

    <!-- Menus: the bar in the menu colour, no tick / icon column beyond what Fluent draws. -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource ThemeMenuBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
    </Style>
    <Style Selector="Menu > MenuItem">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource ThemeMenuBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="0,4"/>
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MaxWidth" Value="420"/>
    </Style>

    <!-- Inputs: square, in the field colour. -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelectedBrush}"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}"/></Style>
    <!-- The selected row: the accent with white text while the list has the keyboard, the pale hover colour when it doesn't (WPF's
         active / inactive selection, which the WPF theme set through HighlightBrushKey and InactiveSelectionHighlightBrushKey). A
         list whose items carry their own accent-coloured text (the script window's suggestions, shown while the editor keeps
         the keyboard) stays readable that way. -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}"/></Style>
    <Style Selector="ListBox:focus-within ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ThemeSelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}"/>
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}"/>
    </Style>

    <!-- Tabs: a raised chip, lighter when selected. (The main window styles its own, see MainWindow.axaml.) -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted2Brush}"/>
        <Setter Property="Background" Value="{DynamicResource ThemeRaisedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#Bd"><Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}"/></Style>
    <Style Selector="TabItem:selected /template/ Border#Bd"><Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}"/></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/></Style>
</Styles>
