// A sample LBA Assembler race track plan: the Desert island's lap, drawn with fewer points.
//
// Build it: Build > Race track..., tick "Desert island", choose "A plan file:", pick this file, and under
// "the track of" choose Desert island. (Or "Save its built-in track as a plan file..." there, to start from
// any island's own track.) The other islands ticked are built with their own tracks.
//
// The file is JSON, with // comments allowed. Only "originCellX", "originCellZ" and "points" are needed;
// everything else is optional.
{
  // Where the plan's cells are counted from, in island cells (an island is up to 16 x 16 cubes, a cube 64 x 64
  // cells, a cell 512 world units). The Desert island's plans use cube (7, 7)'s corner: 7 x 64 = 448.
  "originCellX": 448,
  "originCellZ": 448,

  // The middle line of the lap, [x, z] in cells from the origin, in the order the cars drive it. It is a closed
  // loop: the last point joins back to the first. The builder spaces the points out evenly along the line and
  // smooths it, so a point every 15 to 25 cells is enough; draw the corners with a few points each.
  "points": [
    [199.9, 229.3], [181.0, 240.7], [158.8, 244.1], [137.1, 246.6], [115.1, 252.6], [94.6, 260.7],
    [74.8, 267.8], [59.6, 253.4], [44.6, 239.6], [29.1, 232.5], [13.3, 242.6], [12.4, 224.5],
    [17.9, 204.5], [38.1, 201.0], [53.8, 212.6], [65.5, 225.9], [85.6, 224.7], [107.0, 217.7],
    [124.2, 205.4], [146.0, 205.9], [168.0, 206.4], [176.8, 194.4], [157.6, 190.5], [137.8, 182.0],
    [117.7, 180.5], [104.8, 166.1], [84.6, 155.5], [64.3, 159.8], [44.7, 153.8], [31.6, 136.6],
    [29.8, 114.3], [35.4, 94.1], [40.2, 87.7], [46.1, 107.2], [53.4, 127.9], [72.8, 138.7],
    [95.5, 136.6], [115.6, 144.3], [132.3, 158.3], [152.8, 166.0], [175.0, 169.1], [195.5, 161.2],
    [213.1, 147.6], [221.0, 129.5], [204.7, 117.4], [186.3, 104.9], [175.2, 86.9], [185.7, 73.1],
    [202.7, 59.5], [211.4, 40.1], [200.5, 35.3], [183.9, 46.4], [169.7, 59.9], [147.6, 64.3],
    [135.2, 82.8], [126.5, 102.9], [136.6, 125.2], [138.4, 144.3], [153.9, 159.9], [173.5, 170.6],
    [195.0, 175.9], [210.3, 185.9], [203.9, 207.4]
  ],

  // The pit lane: its two ends, [x, z] cells from the origin, beside the lap (it runs beside the road between
  // them, and the start line is in its middle). Leave both out for no pit lane, and give "start" instead: the
  // number of the point the start line stands on (0 is the first).
  "pitA": [88.4, 261.0],
  "pitB": [206.3, 206.7],

  // Optional: the road's widths, cells from its middle (asphalt, kerbs, verge, and how far the levelled
  // ground blends back into the island's). These are the usual ones.
  "asphaltHalf": 3.5,
  "curbHalf": 4.5,
  "vergeHalf": 6.0,

  // Optional: hand adjustments to the checkpoints the builder places -- move checkpoint 7 two cells to the
  // left, or add one of your own at a point of the lap.
  "checkpointTweaks": [
    { "number": 7, "left": 2.0 },
  ],

  // Much more is possible -- heights for every point ("heights", world units: a road up a mountain), raised
  // roads on piers ("raised"), bridges ("deck"), jumps over gaps ("gapJump"), loops, boost panels, a sprint from
  // start to finish ("open": true with "finish") -- see the island plans in docs/racetrack/ and
  // docs/LBA2_DESERT_RACE_TRACK_BUILD.md.
}
